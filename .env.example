# ==============================================================================
# Variáveis de Ambiente - Catálogo de Filmes & Microsserviço de Login (ISW055)
# Copie este arquivo como .env e preencha com suas credenciais reais.
# NUNCA comite o arquivo .env no Git!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Configurações Gerais da Aplicação
# ------------------------------------------------------------------------------
# Porta pública do container Catálogo (mapeada no host / Portainer)
PORT=3000

# URL pública da aplicação (usada nos links de recuperação de senha enviados por e-mail)
APP_URL=http://localhost:3000

# URL interna do Microsserviço de Autenticação (rede Docker interna)
AUTH_SERVICE_URL=http://auth-service:4000

# ------------------------------------------------------------------------------
# 2. TMDB (The Movie Database)
# ------------------------------------------------------------------------------
# Obtenha gratuitamente em: https://www.themoviedb.org/settings/api
TMDB_API_KEY=sua_chave_api_tmdb_aqui

# ------------------------------------------------------------------------------
# 3. MariaDB (Banco de Dados Compartilhado)
# ------------------------------------------------------------------------------
DB_HOST=mariadb
DB_PORT=3306
DB_USER=aluno
DB_PASSWORD=alunosenha
DB_NAME=catalogo_filmes

# ------------------------------------------------------------------------------
# 4. Segurança / JWT
# ------------------------------------------------------------------------------
# Chave secreta para assinatura e validação dos tokens JWT
JWT_SECRET=seu_segredo_jwt_super_seguro_e_aleatorio

# ------------------------------------------------------------------------------
# 5. Envio Real de E-mail (Brevo SMTP / API) — Recuperação de Senha
# ------------------------------------------------------------------------------
# Conta Brevo: https://www.brevo.com
# 
# Opção A: Brevo via SMTP (Padrão com Nodemailer)
# Obtenha suas credenciais em: Brevo Dashboard > Configurações > SMTP & API > SMTP
# - SMTP_HOST: smtp-relay.brevo.com
# - SMTP_PORT: 587 (STARTTLS)
# - SMTP_USER: seu e-mail de login na Brevo
# - SMTP_PASS: sua Master SMTP Key (xsmtpsib-...)
# - SMTP_FROM: e-mail de remetente validado na sua conta Brevo
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=seu_email_login_brevo
SMTP_PASS=sua_chave_smtp_brevo
SMTP_FROM="Catálogo Filmes <seu_email_verificado_brevo@dominio.com>"

# Opção B: Brevo via REST API (Alternativa se portas SMTP 587/465 estiverem bloqueadas)
# Obtenha em: Brevo Dashboard > Configurações > SMTP & API > Chaves de API
# BREVO_API_KEY=xkeysib-sua_chave_api_brevo
