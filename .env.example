# ==============================================================================
# Variáveis de Ambiente - Catálogo de Filmes & Microsserviço de Login (ISW055)
# Copie este arquivo como .env e preencha com suas credenciais reais.
# NUNCA comite o arquivo .env no Git!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Configurações Gerais da Aplicação
# ------------------------------------------------------------------------------
# Porta pública do container Catálogo (mapeada no host / Portainer)
PORT=3000

# URL pública da aplicação (usada nos links de recuperação de senha enviados por e-mail)
APP_URL=http://localhost:3000

# URL interna do Microsserviço de Autenticação (rede Docker interna)
AUTH_SERVICE_URL=http://auth-service:4000

# ------------------------------------------------------------------------------
# 2. TMDB (The Movie Database)
# ------------------------------------------------------------------------------
# Obtenha gratuitamente em: https://www.themoviedb.org/settings/api
TMDB_API_KEY=sua_chave_api_tmdb_aqui

# ------------------------------------------------------------------------------
# 3. MariaDB (Banco de Dados Compartilhado)
# ------------------------------------------------------------------------------
DB_HOST=mariadb
DB_PORT=3306
DB_USER=aluno
DB_PASSWORD=alunosenha
DB_NAME=catalogo_filmes

# ------------------------------------------------------------------------------
# 4. Segurança / JWT
# ------------------------------------------------------------------------------
# Chave secreta para assinatura e validação dos tokens JWT
JWT_SECRET=seu_segredo_jwt_super_seguro_e_aleatorio

# ------------------------------------------------------------------------------
# 5. Envio Real de E-mail (SMTP) — Recuperação de Senha
# ------------------------------------------------------------------------------
# Desenvolvimento: Mailtrap (https://mailtrap.io) — Sandbox gratuita para testes
# Produção: Brevo (https://brevo.com) ou outro servidor SMTP transacional
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=seu_usuario_mailtrap
SMTP_PASS=sua_senha_mailtrap
SMTP_FROM="Catálogo Filmes <noreply@catalogofilmes.local>"
