PORT=3000
TMDB_API_KEY=
DB_HOST=mariadb
DB_PORT=3306
DB_USER=aluno
DB_PASSWORD=alunosenha
DB_NAME=catalogo_filmes
JWT_SECRET=chave_jwt_secreta_local_dev
AUTH_SERVICE_URL=http://auth-service:4000
LOG_SERVICE_URL=http://log-service:5000
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_STREAM_KEY=audit:events
APP_URL=http://localhost:3000
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Catálogo Filmes <noreply@catalogofilmes.com>"
RESEND_API_KEY=
BREVO_API_KEY=

# ===== MINIO OBJECT STORAGE (ATIVIDADE 6) =====
# MinIO opera internamente na rede Docker (sem expor portas no host)
# Fotos de perfil são servidas via streaming proxy pelo catálogo
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=catalogo-perfil
AVATAR_STORAGE_MODE=proxy

# ===== STRIPE PAGAMENTO E PLANO PREMIUM (ATIVIDADE 7) =====
# Obtenha as chaves de teste gratuitas em https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
# Obtenha o Webhook Secret no Dashboard do Stripe ou via Stripe CLI:
# stripe listen --forward-to localhost:3000/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=whsec_...
# Opcional: ID de preço existente (ex: price_12345). Se vazio, cria dinamicamente o plano de R$ 9,90/mês
STRIPE_PRICE_ID=
